<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <SelfContained>true</SelfContained>
    <AssemblyName>wpfgfx_cor3</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnablePInvokeAnalyzer>true</EnablePInvokeAnalyzer>
    <WpfGfxShapeRuntimeHeapDiagnostic Condition="'$(WpfGfxShapeRuntimeHeapDiagnostic)' == ''">false</WpfGfxShapeRuntimeHeapDiagnostic>
    <DefineConstants Condition="'$(WpfGfxShapeRuntimeHeapDiagnostic)' == 'true'">$(DefineConstants);WPFGFX_RUNTIME_HEAP_DIAGNOSTIC</DefineConstants>
    <PublishDir Condition="'$(WpfGfxShapeRuntimeHeapDiagnostic)' == 'true'">$(WpfGfxShapeArtifactsRoot)runtime-heap-owner-r1/native/</PublishDir>
    <WpfGfxShapeDiagnosticAbi Condition="'$(WpfGfxShapeDiagnosticAbi)' == ''">false</WpfGfxShapeDiagnosticAbi>
    <DebuggerSupport Condition="'$(WpfGfxShapeDiagnosticAbi)' != 'true'">false</DebuggerSupport>
    <DefineConstants Condition="'$(WpfGfxShapeDiagnosticAbi)' == 'true'">$(DefineConstants);WPFGFX_DIAGNOSTIC_ABI</DefineConstants>
    <PublishDir Condition="'$(WpfGfxShapeDiagnosticAbi)' == 'true'">$(WpfGfxShapeArtifactsRoot)diagnostic-publish\$(MSBuildProjectName)\$(Configuration)\$(RuntimeIdentifier)\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WpfGfxShape.Tests" />
    <EmbeddedResource Include="..\..\..\src\Microsoft.DotNet.Wpf\src\WpfGfx\core\hw\Shaders.rc"
                      LogicalName="WpfGfxShape.Resources.TextPixelShaders.rc" />
    <EmbeddedResource Include="..\..\..\src\Microsoft.DotNet.Wpf\src\WpfGfx\core\hw\ShaderAssemblies\Source\ShaderEffectsVS.fx"
                      LogicalName="WpfGfxShape.Resources.ShaderEffectsVS.fx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Direct3D11" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Direct3D9" Version="2.23.0" />
    <PackageReference Include="Silk.NET.DXGI" Version="2.23.0" />
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.298">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
