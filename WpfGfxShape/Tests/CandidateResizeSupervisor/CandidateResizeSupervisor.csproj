<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion></PropertyGroup>
  <PropertyGroup><CandidatePackageDirectory Condition="'$(CandidatePackageDirectory)' == ''">../../artifacts/candidate-resize-r8/Package</CandidatePackageDirectory></PropertyGroup>
  <ItemGroup><Content Include="$(CandidatePackageDirectory)/**/*" Link="Package/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="Always" /></ItemGroup>
  <Target Name="GenerateResizeSupervisor" BeforeTargets="CoreCompile">
    <PropertyGroup><ResizeRun>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../CandidateVideoSupervisor/VideoRun.cs'))</ResizeRun><ResizeRun>$(ResizeRun.Replace('VideoRun', 'ResizeRun').Replace('CandidatePureVideo.exe', 'CandidateResize.exe').Replace('purevideo-public', 'resize').Replace('purevideo-completed', 'resize-completed').Replace('candidate-video', 'candidate-resize'))</ResizeRun></PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)ResizeRun.cs" Lines="$(ResizeRun)" Overwrite="true" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)ResizeRun.cs" /></ItemGroup>
  </Target>
</Project>
