<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained><RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion><PublishAot>false</PublishAot>
    <DefineConstants>$(DefineConstants);GEOMETRY_R27;STRICT_R28</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../CandidatePureVideo/Program.cs" Link="Program.cs" />
    <Compile Include="../CandidatePureVideo/GeometryR27.cs" Link="GeometryR27.cs" />
    <Content Include="../../artifacts/candidate-geometry-r27/native/wpfgfx_cor3.dll" Link="Native/wpfgfx_cor3.dll" CopyToPublishDirectory="Always" />
  </ItemGroup>
  <Target Name="PinRuntime" BeforeTargets="ProcessFrameworkReferences">
    <ItemGroup><FrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App.WPF" RuntimeFrameworkVersion="10.0.13" /></ItemGroup>
  </Target>
  <Target Name="IsolateOfficial" AfterTargets="ComputeFilesToPublish" BeforeTargets="CopyFilesToPublishDirectory">
    <ItemGroup>
      <OfficialGfx Include="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'wpfgfx_cor3.dll' and '%(ResolvedFileToPublish.RelativePath)' == 'wpfgfx_cor3.dll'" />
      <ResolvedFileToPublish Remove="@(OfficialGfx)" />
    </ItemGroup>
    <Error Condition="'@(OfficialGfx)' == ''" Text="Pinned official runtime graphics file missing." />
    <Copy SourceFiles="@(OfficialGfx)" DestinationFolder="$(PublishDir)Reference" />
    <WriteLinesToFile File="$(PublishDir)official-source.txt" Lines="@(OfficialGfx->'%(FullPath)')" Overwrite="true" />
  </Target>
</Project>
