<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><RuntimeIdentifier>win-x64</RuntimeIdentifier><RuntimeFrameworkVersion>10.0.1</RuntimeFrameworkVersion><RollForward>Disable</RollForward></PropertyGroup>
  <ItemGroup Condition="'$(EvidenceInput)' != ''">
    <Content Include="$(EvidenceInput)/Baseline/shadow-*.pbgra32" Link="Baseline/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(EvidenceInput)/ComparisonCandidate/shadow-*.pbgra32" Link="ComparisonCandidate/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
