<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OutputType>Exe</OutputType>
    <StartupObject>WpfGfxShape.ComAcceptance.NativeRun</StartupObject>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <TestingPlatformGenerateEntryPoint>false</TestingPlatformGenerateEntryPoint>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <EnableMSTestV2CopyResources>false</EnableMSTestV2CopyResources>
    <ComAcceptanceSandbox Condition="'$(ComAcceptanceSandbox)' == ''">false</ComAcceptanceSandbox>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)acceptance.runsettings</RunSettingsFilePath>
    <AotRuntimeIdentifier Condition="'$(AotRuntimeIdentifier)' == ''">win-x64</AotRuntimeIdentifier>
    <AotDllPath Condition="'$(AotDllPath)' == ''">$(MSBuildThisFileDirectory)../../artifacts/publish/WpfGfxShape/Release/$(AotRuntimeIdentifier)/wpfgfx_cor3.dll</AotDllPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Code/WpfGfxShape/Core/SoftwareFillBezier.cs" Link="FillInteger/SoftwareFillBezier.cs" />
    <PackageReference Include="MSTest" Version="4.0.1" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Using Include="System.IO" />
    <None Include="../../../src/Microsoft.DotNet.Wpf/src/WpfGfx/include/wgx_sdk_version.h" Link="Contracts/wgx_sdk_version.h" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../src/Microsoft.DotNet.Wpf/src/WpfGfx/core/dll/wpfgfx.def" Link="Contracts/wpfgfx.def" CopyToOutputDirectory="PreserveNewest" />
    <AssemblyMetadata Include="ReferenceResultsPath" Value="$(WpfGfxShapeTestResultsRoot)native-reference" Condition="'$(ComAcceptanceSandbox)' != 'true'" />
    <AssemblyMetadata Include="ReferenceResultsPath" Value="ReferenceData" Condition="'$(ComAcceptanceSandbox)' == 'true'" />
    <None Include="$(AotDllPath)" Link="Native/wpfgfx_cor3.dll" CopyToPublishDirectory="PreserveNewest" Condition="'$(ComAcceptanceSandbox)' == 'true'" />
    <AssemblyMetadata Include="ComAcceptanceSandbox" Value="$(ComAcceptanceSandbox)" />
    <AssemblyMetadata Include="CalibrationResultsPath" Value="$(WpfGfxShapeTestResultsRoot)native" Condition="'$(ComAcceptanceSandbox)' != 'true'" />
    <AssemblyMetadata Include="AotDllPath" Value="$([System.IO.Path]::GetFullPath('$(AotDllPath)'))" Condition="'$(ComAcceptanceSandbox)' != 'true'" />
    <AssemblyMetadata Include="CalibrationResultsPath" Value="Results" Condition="'$(ComAcceptanceSandbox)' == 'true'" />
    <AssemblyMetadata Include="AotDllPath" Value="Native/wpfgfx_cor3.dll" Condition="'$(ComAcceptanceSandbox)' == 'true'" />
  </ItemGroup>
  <Import Project="ComAcceptance.Package.targets" />
</Project>
