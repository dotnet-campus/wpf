<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CandidateNativeDirectory Condition="'$(CandidateNativeDirectory)' == ''">../../artifacts/supervised-native-video-x64-r1/native</CandidateNativeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(CandidateNativeDirectory)/wpfgfx_cor3.dll" Link="Native/wpfgfx_cor3.dll" CopyToPublishDirectory="Always" />
    <Content Include="../../Code/WpfGfxShape/**/*.cs;../../Code/WpfGfxShape/WpfGfxShape.csproj" Link="Source/Production/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="Always" />
    <Content Include="../WpfGfxShape.ComAcceptance/**/*.cs;../WpfGfxShape.ComAcceptance/*.csproj;../WpfGfxShape.ComAcceptance/*.targets;../WpfGfxShape.ComAcceptance/*.resx" Link="Source/Harness/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="Always" />
    <Content Include="../../Directory.Build.props;../../Directory.Build.targets" Link="Source/Build/%(Filename)%(Extension)" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
