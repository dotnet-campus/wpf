<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier><SelfContained>true</SelfContained><RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion><PublishAot>false</PublishAot>
    <StartupObject>NativeAcceptance.Pcore.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup><Using Include="System.IO" /><Compile Remove="DpiImports.cs" /><Content Include="../../artifacts/candidate-resize-r8/Package/Native/wpfgfx_cor3.dll" Link="Native/wpfgfx_cor3.dll" CopyToPublishDirectory="Always" /></ItemGroup>
  <Target Name="PinRuntime" BeforeTargets="ProcessFrameworkReferences"><ItemGroup><FrameworkReference Update="Microsoft.NETCore.App;Microsoft.WindowsDesktop.App.WPF" RuntimeFrameworkVersion="10.0.13" /></ItemGroup></Target>
  <Target Name="ExcludeRuntimeGfx" AfterTargets="ComputeFilesToPublish" BeforeTargets="CopyFilesToPublishDirectory"><ItemGroup><ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'wpfgfx_cor3.dll' and '%(ResolvedFileToPublish.RelativePath)' != 'Native/wpfgfx_cor3.dll' and '%(ResolvedFileToPublish.RelativePath)' != 'Native\wpfgfx_cor3.dll'" /></ItemGroup></Target>
  <Target Name="GenerateBootstrap" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <Bootstrap>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../CandidatePureVideo/Program.cs'))</Bootstrap>
      <Bootstrap>$(Bootstrap.Replace('args[1] != &quot;purevideo-public&quot;', '(args[1] != &quot;resize&quot; &amp;&amp; args[1] != &quot;rtb-lifecycle&quot;)').Replace('RenderPureVideoPublic();', 'CandidateResizeScene.Run();').Replace('Checkpoint(&quot;purevideo-completed&quot;);', 'Checkpoint(args[1] == &quot;rtb-lifecycle&quot; ? &quot;rtb-lifecycle-completed&quot; : &quot;resize-completed&quot;);'))</Bootstrap>
      <Scene>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../WpfGfxShape.ComAcceptance/ReplacementStateSequenceWindowTests.cs'))</Scene>
      <SceneStart>$(Scene.IndexOf('    [MethodImpl(MethodImplOptions.NoInlining)]'))</SceneStart>
      <SceneBody>$(Scene.Substring($(SceneStart)))</SceneBody>
      <SceneBody>$(SceneBody.Replace('            window.Show();', '            window.Show();&#xA;            DesktopEnvironment.Record(window, cycle, directory);'))</SceneBody>
      <SceneHeader>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)SceneHeader.txt'))</SceneHeader>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)ResizeBootstrap.cs" Lines="$(Bootstrap)" Overwrite="true" />
    <WriteLinesToFile File="$(IntermediateOutputPath)ResizeScene.cs" Lines="$(SceneHeader)$(SceneBody)" Overwrite="true" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)ResizeBootstrap.cs" /><Compile Include="$(IntermediateOutputPath)ResizeScene.cs" /></ItemGroup>
  </Target>
  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.1" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <Compile Include="../WpfGfxShape.ComAcceptance/D3DImageTests.OutputWindow.cs" Link="OutputWindow.cs" />
    <Compile Include="../WpfGfxShape.ComAcceptance/D3DImageTests.WindowThread.cs" Link="WindowThread.cs" />
    <Compile Include="../WpfGfxShape.ComAcceptance/D3DImageTests.PresentDiagnostics.cs" Link="PresentDiagnostics.cs" />
    <Compile Include="../WpfGfxShape.ComAcceptance/D3DImageTests.SwapChainObservation.cs" Link="SwapChainObservation.cs" />
  </ItemGroup>
  <Target Name="GenerateNativeControl" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BaseSource>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../WpfGfxShape.ComAcceptance/D3DImageTests.cs'))</BaseSource>
      <DeclarationsStart>$(BaseSource.IndexOf('    [DllImport(&quot;user32.dll&quot;, CharSet = CharSet.Unicode)]'))</DeclarationsStart>
      <DeclarationsEnd>$(BaseSource.IndexOf('    private static uint BindPassThroughEffect'))</DeclarationsEnd>
      <Declarations>$(BaseSource.Substring($(DeclarationsStart), $([MSBuild]::Subtract($(DeclarationsEnd), $(DeclarationsStart)))))</Declarations>
      <GpuSource>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../WpfGfxShape.ComAcceptance/D3DImageTests.GpuReadback.cs'))</GpuSource>
      <ObservableStart>$(GpuSource.IndexOf('    private static void EstablishObservableWindow'))</ObservableStart>
      <Observable>$(GpuSource.Substring($(ObservableStart)))</Observable>
      <SwapSource>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../WpfGfxShape.ComAcceptance/D3DImageTests.VisualCache.cs'))</SwapSource>
      <PixelStart>$(SwapSource.IndexOf('    private static void AssertCombinedPixel'))</PixelStart>
      <PixelEnd>$(SwapSource.IndexOf('    private static void BindTwoInputEffect'))</PixelEnd>
      <Pixel>$(SwapSource.Substring($(PixelStart), $([MSBuild]::Subtract($(PixelEnd), $(PixelStart)))))</Pixel>
      <Pixel>$(Pixel.Replace('officialCacheObservation?.Record(&quot;pixel&quot;, new { Hwnd = (long)window, X = 16, Y = 8, Expected = expected, Actual = actual });', ''))</Pixel>
      <NativeHeader>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)NativeControlHeader.txt'))</NativeHeader>
    </PropertyGroup>
    <PropertyGroup>
      <OutputSource>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../WpfGfxShape.ComAcceptance/D3DImageTests.OutputWindow.cs'))</OutputSource>
      <OutputSource>$(OutputSource.Replace('        // The consumer owns', '        DiagnosticMessage(window, message);&#xA;        // The consumer owns').Replace('            Assert.AreEqual(0, DwmFlush());', '            DiagnosticRecord(&quot;dwm-before&quot;, new { });&#xA;            Assert.AreEqual(0, DwmFlush());&#xA;            DiagnosticSample(window, &quot;dwm-after&quot;);'))</OutputSource>
      <SwapSource>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../WpfGfxShape.ComAcceptance/D3DImageTests.SwapChainObservation.cs'))</SwapSource>
      <SwapSource>$(SwapSource.Replace('        int result;', '        DiagnosticClearedBuffer(device);&#xA;        int result;'))</SwapSource>
      <SwapSource>$(SwapSource.Replace('        Assert.AreEqual(0, ((delegate*', '        DiagnosticRecord(&quot;clear-before&quot;, new { });&#xA;        Assert.AreEqual(0, ((delegate*').Replace('#if ORIGINAL_PRESENT_DXGKRNL', '        DiagnosticRecord(&quot;present-boundary&quot;, new { });&#xA;#if ORIGINAL_PRESENT_DXGKRNL').Replace('        Assert.AreEqual(0, result);', '        DiagnosticRecord(&quot;present-result&quot;, new { result });&#xA;        DiagnosticSample(window, &quot;present-after&quot;);&#xA;        Assert.AreEqual(0, result);'))</SwapSource>
      <NativeHeader>$(NativeHeader.Replace('            Release(device); Release(factory);', '            if (window != 0) DiagnosticGdiControl(window);&#xA;            Release(device); Release(factory);'))</NativeHeader>
      <NativeHeader>$(NativeHeader.Replace('            PresentNativeControl(window, device, false);', '            DiagnosticDevice(window, device);&#xA;            DiagnosticSample(window, &quot;before-clear&quot;);&#xA;            PresentNativeControl(window, device, false);').Replace('            AssertCombinedPixel(window, 0x00563412);', '            DiagnosticSample(window, &quot;before-original-oracle&quot;);&#xA;            AssertCombinedPixel(window, 0x00563412);').Replace('            if (window != 0) DestroyWindow(window);', '            if (window != 0) DiagnosticRecord(&quot;destroy-window&quot;, new { Result = DestroyWindow(window) });'))</NativeHeader>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)DiagnosticOutputWindow.cs" Lines="$(OutputSource)" Overwrite="true" />
    <WriteLinesToFile File="$(IntermediateOutputPath)DiagnosticSwapChain.cs" Lines="$(SwapSource)" Overwrite="true" />
    <ItemGroup><Compile Remove="../WpfGfxShape.ComAcceptance/D3DImageTests.OutputWindow.cs" /><Compile Remove="../WpfGfxShape.ComAcceptance/D3DImageTests.SwapChainObservation.cs" /><Compile Include="$(IntermediateOutputPath)DiagnosticOutputWindow.cs" /><Compile Include="$(IntermediateOutputPath)DiagnosticSwapChain.cs" /></ItemGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)NativeControl.cs" Lines="$(NativeHeader)$(Declarations)$(Pixel)$(Observable)" Overwrite="true" />
    <ItemGroup><Compile Include="$(IntermediateOutputPath)NativeControl.cs" /></ItemGroup>
  </Target>
  <Target Name="Digest" AfterTargets="Publish"><GetFileHash Files="$(PublishDir)Native/wpfgfx_cor3.dll" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="Digest" /></GetFileHash><WriteLinesToFile File="$(PublishDir)aot.sha256" Lines="@(Digest->'%(FileHash)')" Overwrite="true" /><Error Condition="Exists('$(PublishDir)wpfgfx_cor3.dll')" Text="Unexpected root graphics binary." /></Target>
</Project>
