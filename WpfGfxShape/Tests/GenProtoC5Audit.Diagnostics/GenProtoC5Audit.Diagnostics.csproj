<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../Investigations/GenProtoEvidence/c5-selected-evaluation/*.evaluation.xml" Link="Inputs/Evaluation/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Investigations/GenProtoEvidence/c5-selected-evaluation/report.json" Link="Inputs/evaluation-report.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../Ledger/records.jsonl;../../Ledger/groups.jsonl;../../Ledger/evidence.jsonl" Link="Inputs/Ledger/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../artifacts/log/GenProto-C5/**/*" Link="Inputs/CL/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <UsingTask TaskName="StageC5Sources" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup><Report ParameterType="System.String" Required="true" /><Root ParameterType="System.String" Required="true" /><Destination ParameterType="System.String" Required="true" /></ParameterGroup>
    <Task>
      <Using Namespace="System.IO" /><Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        foreach (Match match in Regex.Matches(File.ReadAllText(Report), "\"From\"\\s*:\\s*\"([^\"]+)\""))
        {
            string relative = match.Groups[1].Value;
            string source = Path.Combine(Root, relative);
            if (!File.Exists(source)) continue;
            string target = Path.Combine(Destination, relative);
            Directory.CreateDirectory(Path.GetDirectoryName(target));
            File.Copy(source, target, true);
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="StageOriginalC5Sources" AfterTargets="Publish">
    <StageC5Sources Report="$(MSBuildProjectDirectory)/../../Investigations/GenProtoEvidence/c5-selected-evaluation/report.json" Root="$(MSBuildProjectDirectory)/../../.." Destination="$(PublishDir)Inputs/Source" />
  </Target>
</Project>
