<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WpfGfxShape.Tests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>false</PublishAot>
    <StartupObject>Program</StartupObject>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.0.1" />
    <ProjectReference Include="../../Code/WpfGfxShape/WpfGfxShape.csproj" />
    <Compile Include="../WpfGfxShape.Tests/MediaFoundationResourceTests.cs" Link="MediaFoundationResourceTests.cs" />
    <Compile Include="../WpfGfxShape.Tests/MediaFoundationResourceTests.Cancellation.cs" Link="MediaFoundationResourceTests.Cancellation.cs" />
    <Compile Include="../WpfGfxShape.Tests/MediaFoundationResourceTests.PropVariant.cs" Link="MediaFoundationResourceTests.PropVariant.cs" />
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>
</Project>
