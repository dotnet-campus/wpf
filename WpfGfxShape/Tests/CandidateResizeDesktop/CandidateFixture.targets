<Project>
  <Target Name="InstrumentIndependentDesktopObservation" BeforeTargets="CoreCompile" Condition="'$(MSBuildProjectName)' == 'WpfGfxShape.ComAcceptance'">
    <PropertyGroup>
      <R16Visual>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/D3DImageTests.VisualCache.cs'))</R16Visual>
      <R16Visual>$(R16Visual.Replace('ExitDiagnostics.Stage("visual CreateDevice after; PresentNativeControl before");', 'R16Begin(window); ExitDiagnostics.Stage("visual CreateDevice after; PresentNativeControl before");').Replace('AssertCombinedPixel(window, 0x00563412);', 'R16Observe(window); AssertCombinedPixel(window, 0x00563412);'))</R16Visual>
      <R16Visual>$(R16Visual.Replace('PresentNativeControl(window, device, false);', 'R18Run(window, device);'))</R16Visual>
      <R18Swap>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/D3DImageTests.SwapChainObservation.cs'))</R18Swap>
      <R18Swap>$(R18Swap.Replace('        Assert.AreEqual(0, ((delegate* unmanaged[Stdcall]&lt;nint, uint, nint, uint, uint, float, uint, int&gt;)', '        R18Mark("clear-before"); Assert.AreEqual(0, ((delegate* unmanaged[Stdcall]&lt;nint, uint, nint, uint, uint, float, uint, int&gt;)').Replace('        int result;', '        R18Mark("present-before"); int result;').Replace('        if (extended &amp;&amp; result == 0x08760878)', '        r18PresentReturn = System.Diagnostics.Stopwatch.GetTimestamp(); R16Write("present-return", new { qpc = r18PresentReturn, result }); if (extended &amp;&amp; result == 0x08760878)'))</R18Swap>
      <R16Output>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/D3DImageTests.OutputWindow.cs'))</R16Output>
      <R16Output>$(R16Output.Replace('if (message == 0x14) return 1;', 'R16Message(window, message, wParam, lParam); if (message == 0x14) return 1;'))</R16Output>
    </PropertyGroup>
    <WriteLinesToFile File="$(IntermediateOutputPath)R16Visual.cs" Lines="$(R16Visual)" Overwrite="true" />
    <WriteLinesToFile File="$(IntermediateOutputPath)R16Output.cs" Lines="$(R16Output)" Overwrite="true" />
    <WriteLinesToFile File="$(IntermediateOutputPath)R18Swap.cs" Lines="$(R18Swap)" Overwrite="true" />
    <ItemGroup>
      <Compile Remove="D3DImageTests.VisualCache.cs;D3DImageTests.OutputWindow.cs;D3DImageTests.SwapChainObservation.cs" />
      <Compile Include="$(IntermediateOutputPath)R16Visual.cs;$(IntermediateOutputPath)R16Output.cs;$(IntermediateOutputPath)R18Swap.cs;$(MSBuildThisFileDirectory)ObservationDiagnostic.cs" />
    </ItemGroup>
  </Target>
  <Target Name="SetIndependentDesktopFixtureMetadata" BeforeTargets="GetAssemblyAttributes">
    <ItemGroup>
      <AssemblyMetadata Remove="ComAcceptanceSandbox;CalibrationResultsPath;AotDllPath" />
      <AssemblyMetadata Include="ComAcceptanceSandbox" Value="true" />
      <AssemblyMetadata Include="CalibrationResultsPath" Value="Results" />
      <AssemblyMetadata Include="AotDllPath" Value="Native/wpfgfx_cor3.dll" />
    </ItemGroup>
  </Target>
</Project>
