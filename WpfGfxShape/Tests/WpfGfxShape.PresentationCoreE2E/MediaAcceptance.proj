<Project DefaultTargets="Prepare">
  <PropertyGroup>
    <Root>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..\'))</Root>
    <Package>$(Root)artifacts\staging\PresentationCoreE2E\</Package>
    <Original>$(Root)artifacts\sandbox-readback\e2e08-latest-original\Results\original\</Original>
    <CandidateResults>$(Root)artifacts\sandbox-readback\e2e08-latest-candidate\Results\candidate\</CandidateResults>
    <BuildOutput>$(Root)artifacts\bin\WpfGfxShape.PresentationCoreE2E\Release\net10.0-windows\win-x64\</BuildOutput>
  </PropertyGroup>
  <Target Name="Prepare">
    <ItemGroup>
      <Oracle Include="$(Original)result.json;$(Original)media-*.pbgra32;$(Original)media-*.avi" />
    </ItemGroup>
    <Copy SourceFiles="@(Oracle)" DestinationFolder="$(Package)Baseline" />
    <ItemGroup>
      <Actual Include="$(CandidateResults)result.json;$(CandidateResults)media-*.pbgra32" />
      <App Include="$(BuildOutput)WpfGfxShape.PresentationCoreE2E.exe;$(BuildOutput)WpfGfxShape.PresentationCoreE2E.dll;$(BuildOutput)WpfGfxShape.PresentationCoreE2E.deps.json;$(BuildOutput)WpfGfxShape.PresentationCoreE2E.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(Actual)" DestinationFolder="$(Package)ComparisonCandidate" />
    <Copy SourceFiles="@(App)" DestinationFolder="$(Package)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)MediaScenes.cs;$(MSBuildThisFileDirectory)MediaAcceptance.proj" DestinationFolder="$(Package)Sources" />
    <GetFileHash Files="@(Oracle);$(Package)Candidate\wpfgfx_cor3.dll;$(Package)WpfGfxShape.PresentationCoreE2E.dll" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="Identity" /></GetFileHash>
    <WriteLinesToFile File="$(Package)media-input-identities.txt" Lines="@(Identity->'%(Identity) | %(FileHash)')" Overwrite="true" />
  </Target>
</Project>
