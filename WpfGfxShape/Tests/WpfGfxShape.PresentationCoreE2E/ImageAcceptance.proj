<Project DefaultTargets="Prepare">
  <PropertyGroup>
    <Root>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..\'))</Root>
    <Runs>$(Root)Investigations\PresentationCore-render\Results\</Runs>
    <Package>$(Root)artifacts\staging\PresentationCoreE2E\</Package>
  </PropertyGroup>
  <Target Name="Prepare">
    <ItemGroup>
      <Original Include="$(Runs)image-original-10\Results\original\*.pbgra32;$(Runs)image-original-10\Results\original\result.json" />
      <Candidate Include="$(Runs)image-candidate-10\Results\candidate\*.pbgra32" />
      <Modules Include="$(Package)Candidate\wpfgfx_cor3.dll;$(Package)WpfGfxShape.PresentationCoreE2E.dll;$(Root)Code\WpfGfxShape\Core\GeneratedImageMask.cs" />
    </ItemGroup>
    <Copy SourceFiles="@(Original)" DestinationFolder="$(Package)Baseline\" />
    <Copy SourceFiles="@(Candidate)" DestinationFolder="$(Package)ComparisonCandidate\" />
    <GetFileHash Files="@(Original);@(Candidate);@(Modules)" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="Identities" /></GetFileHash>
    <WriteLinesToFile File="$(Runs)image-acceptance-10-identities.txt" Lines="@(Identities->'%(FullPath) | %(FileHash)')" Overwrite="true" />
  </Target>
</Project>
