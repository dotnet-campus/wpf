<Project DefaultTargets="StageComparison">
  <PropertyGroup>
    <Root>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..\'))</Root>
    <Package>$(Root)artifacts\staging\PresentationCoreE2E\</Package>
    <Runs>$(Root)Investigations\PresentationCore-render\Results\</Runs>
    <CandidateRun Condition="'$(CandidateRun)' == ''">dropshadow-final-candidate-06</CandidateRun>
  </PropertyGroup>
  <Target Name="StageComparison">
    <ItemGroup>
      <Original Include="$(Runs)dropshadow-final-original-06\Results\original\shadow-*.pbgra32" />
      <Candidate Include="$(Runs)$(CandidateRun)\Results\candidate\shadow-*.pbgra32" />
    </ItemGroup>
    <Error Condition="'@(Original->Count())' != '28' Or '@(Candidate->Count())' != '28'" Text="Both independent shadow roles must supply twenty-eight frames." />
    <Copy SourceFiles="@(Original)" DestinationFolder="$(Package)Baseline" />
    <Copy SourceFiles="@(Candidate)" DestinationFolder="$(Package)ComparisonCandidate" />
    <GetFileHash Files="@(Original);@(Candidate)" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="Identity" /></GetFileHash>
    <WriteLinesToFile File="$(Runs)$(CandidateRun)-input-identities.txt" Lines="@(Identity->'%(Identity) | %(FileHash)')" Overwrite="true" />
  </Target>
</Project>
