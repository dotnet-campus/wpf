<Project DefaultTargets="Build">
  <PropertyGroup>
    <Root>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..\'))</Root>
    <Package>$(Root)artifacts\staging\DispatcherE2E\</Package>
    <BuildOutput>$(Root)artifacts\bin\WpfGfxShape.PresentationCoreE2E\Release\net10.0-windows\win-x64\</BuildOutput>
    <Candidate>$(Root)artifacts\publish\WpfGfxShape\Release\win-x64\wpfgfx_cor3.dll</Candidate>
    <OriginalResults>$(Root)artifacts\sandbox-readback\dispatcher-original\Results\original\</OriginalResults>
    <CandidateResults>$(Root)artifacts\sandbox-readback\dispatcher-fixed-candidate\Results\candidate\</CandidateResults>
  </PropertyGroup>
  <Target Name="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)WpfGfxShape.PresentationCoreE2E.csproj" Targets="Restore;Build" Properties="Configuration=Release" />
    <ItemGroup>
      <App Include="$(BuildOutput)WpfGfxShape.PresentationCoreE2E.exe;$(BuildOutput)WpfGfxShape.PresentationCoreE2E.dll;$(BuildOutput)WpfGfxShape.PresentationCoreE2E.deps.json;$(BuildOutput)WpfGfxShape.PresentationCoreE2E.runtimeconfig.json" />
      <Original Include="$(OriginalResults)dispatcher*.json;$(OriginalResults)dispatcher*.pbgra32" />
      <Compared Include="$(CandidateResults)dispatcher*.json;$(CandidateResults)dispatcher*.pbgra32" />
      <Sources Include="$(MSBuildThisFileDirectory)Program.cs;$(MSBuildThisFileDirectory)DispatcherScenes.cs;$(MSBuildThisFileDirectory)MediaScenes.cs;$(MSBuildThisFileDirectory)DispatcherAcceptance.proj" />
    </ItemGroup>
    <Copy SourceFiles="@(App)" DestinationFolder="$(Package)" />
    <Copy SourceFiles="$(Candidate)" DestinationFolder="$(Package)Candidate" />
    <Copy SourceFiles="@(Original)" DestinationFolder="$(Package)Baseline" />
    <Copy SourceFiles="@(Compared)" DestinationFolder="$(Package)ComparisonCandidate" />
    <GetFileHash Files="$(Candidate)" Algorithm="SHA256"><Output TaskParameter="Hash" PropertyName="CandidateHash" /></GetFileHash>
    <WriteLinesToFile File="$(Package)dispatcher-manifest.json" Lines="{&quot;candidateSha256&quot;:&quot;$(CandidateHash)&quot;}" Overwrite="true" />
    <GetFileHash Files="@(App);@(Sources);$(Candidate);@(Original);@(Compared)" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="Identity" /></GetFileHash>
    <WriteLinesToFile File="$(Package)input-identities.txt" Lines="@(Identity->'%(Identity) | %(FileHash)')" Overwrite="true" />
  </Target>
</Project>
