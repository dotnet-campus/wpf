<Project DefaultTargets="Prepare">
  <PropertyGroup>
    <Root>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\..\'))</Root>
    <Runs>$(Root)Investigations\PresentationCore-render\Results\</Runs>
    <Package>$(Root)artifacts\staging\PresentationCoreE2E\</Package>
  </PropertyGroup>
  <Target Name="Prepare">
    <GetFileHash Files="$(Package)Candidate\wpfgfx_cor3.dll" Algorithm="SHA256"><Output TaskParameter="Hash" PropertyName="CandidateHash" /></GetFileHash>
    <Error Condition="'$(CandidateHash)' != '161496D655519FE9964DF2298F995235EB71E3D026341E1B76AEA1DFBDA75BB8'" Text="Lifecycle candidate identity changed." />
    <ItemGroup>
      <Original Include="$(Runs)lifetime-original-02\Results\original\lifetime-*.pbgra32" />
      <Candidate Include="$(Runs)lifetime-candidate-02\Results\candidate\lifetime-*.pbgra32" />
      <Source Include="$(MSBuildThisFileDirectory)LifetimeScenes.cs;$(MSBuildThisFileDirectory)LifetimeAcceptance.proj" />
    </ItemGroup>
    <Error Condition="'@(Original->Count())' != '36' Or '@(Candidate->Count())' != '36'" Text="All 36 independently rendered frames are required." />
    <Copy SourceFiles="@(Original)" DestinationFolder="$(Package)Baseline" />
    <Copy SourceFiles="@(Candidate)" DestinationFolder="$(Package)ComparisonCandidate" />
    <Copy SourceFiles="@(Source)" DestinationFolder="$(Package)Sources" />
    <GetFileHash Files="@(Original);@(Candidate);@(Source);$(Package)Candidate\wpfgfx_cor3.dll" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="Identity" /></GetFileHash>
    <WriteLinesToFile File="$(Runs)lifetime-input-identities-02.txt" Lines="@(Identity->'%(Identity) | %(FileHash)')" Overwrite="true" />
  </Target>
</Project>
