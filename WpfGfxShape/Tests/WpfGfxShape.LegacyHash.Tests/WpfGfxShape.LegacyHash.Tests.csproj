<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <IsTestProject>true</IsTestProject>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <Compile Remove="AuthorityPath.cs" />
    <Compile Include="$(IntermediateOutputPath)AuthorityParser.cs" />
    <Compile Include="../../../src/Microsoft.DotNet.Wpf/src/WpfGfx/tools/csp/CsPrimeRuntime.cs" Link="Authority/CsPrimeRuntime.cs" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.6.4" />
    <PackageReference Include="MSTest.TestFramework" Version="3.6.4" />
    <AssemblyMetadata Include="RepositoryRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../'))" />
  </ItemGroup>
  <Target Name="PrepareAuthorityParser" BeforeTargets="CoreCompile">
    <ReadLinesFromFile File="$(MSBuildThisFileDirectory)../../../src/Microsoft.DotNet.Wpf/src/WpfGfx/tools/csp/CsPrimeParser.cs">
      <Output TaskParameter="Lines" ItemName="AuthorityParserLines" />
    </ReadLinesFromFile>
    <WriteLinesToFile File="$(IntermediateOutputPath)AuthorityParser.cs" Lines="using System%3B;using System.IO%3B;using Path = System.IO.Path%3B;@(AuthorityParserLines)" Overwrite="true" />
  </Target>
</Project>
